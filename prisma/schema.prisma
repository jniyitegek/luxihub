generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  CUSTOMER
  SERVICE_OWNER
  ADMIN
}

enum VerificationSource {
  PUBLIC_REVIEW
  BUSINESS_REGISTRATION
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(CUSTOMER)
  phone        String?
  avatarUrl    String?
  loyaltyPoints Int      @default(0)
  loyaltyTier  String    @default("EXPLORER") // EXPLORER, CONNOISSEUR, AMBASSADOR
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  businesses   Business[]
  bookings     Booking[]
  reviews      Review[]
  tickets      SupportTicket[]
  loyaltyTransactions LoyaltyTransaction[]
}

model Business {
  id                 String              @id @default(cuid())
  ownerId            String?
  owner              User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  name               String
  slug               String              @unique
  type               String              // HOTEL, RESTAURANT, TOUR
  location           String              // Kigali, Musanze, Rubavu, Nyungwe, Akagera
  address            String
  description        String
  shortTagline       String?
  amenities          String              @default("[]") // JSON string array
  images             String              @default("[]") // JSON string array
  pricingTier        String              @default("$$$") // $$, $$$, $$$$
  basePrice          Float               @default(150000)
  currency           String              @default("RWF")
  status             String              @default("VERIFIED") // PENDING, VERIFIED, SUSPENDED
  certificationBadge String              @default("LUXE_VERIFIED") // LUXE_VERIFIED, GOLD_STANDARD, ECO_SUSTAINABLE, NONE
  ratingAvg          Float               @default(0)
  reviewCount        Int                 @default(0)
  isFeatured         Boolean             @default(false)
  isVerified         Boolean             @default(false)
  verificationSource VerificationSource?
  needsAdminAudit    Boolean             @default(false)
  verifiedAt         DateTime?
  verifiedBy         String?
  subscriptionTier   String              @default("STANDARD") // STANDARD, CERTIFIED, ELITE
  featuredUntil      DateTime? // Advanced Visibility Tools: promoted placement expiry
  phone              String?
  email              String?
  website            String?
  logoUrl            String?
  responseRate       Int                 @default(0) // Percentage of guest enquiries answered
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  offerings          ServiceOffering[]
  bookings           Booking[]
  reviews            Review[]
  audits             QAAudit[]
  subscriptions      PartnerSubscription[]
  enrollments        TrainingEnrollment[]

  @@index([ownerId])
  @@index([type])
  @@index([location])
  @@index([status])
  @@index([isVerified])
  @@index([needsAdminAudit])
  @@index([isFeatured, ratingAvg])
}

model ServiceOffering {
  id           String    @id @default(cuid())
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     String    @default("STAYS") // STAYS, EXPERIENCES, DINING, or custom category name
  subType      String?   // e.g., Suite, Villa, Tour, À la carte
  title        String
  description  String
  capacity     Int       @default(2)
  price        Float
  currency     String    @default("RWF")
  unit         String    @default("per_night") // per_night, per_person, per_table, per_tour, etc.
  duration     String?
  coverImage   String?
  images       String    @default("[]") // JSON string array
  inclusions   String    @default("[]") // JSON string array
  attributes   String    @default("{}") // Flexible JSON object for category-specific & custom key/value pairs
  isAvailable  Boolean   @default(true)
  createdAt    DateTime  @default(now())

  bookings     Booking[]

  @@index([businessId])
  @@index([category])
}

model Booking {
  id                String           @id @default(cuid())
  bookingRef        String           @unique
  customerId        String
  customer          User             @relation(fields: [customerId], references: [id])
  businessId        String
  business          Business         @relation(fields: [businessId], references: [id])
  serviceOfferingId String
  serviceOffering   ServiceOffering  @relation(fields: [serviceOfferingId], references: [id])
  checkInDate       DateTime
  checkOutDate      DateTime
  guests            Int              @default(1)
  totalAmount       Float
  depositAmount     Float            @default(0)
  commissionAmount  Float            @default(0) // 10% platform booking commission
  payoutAmount      Float            @default(0) // Amount owed to the partner (totalAmount - commissionAmount)
  currency          String           @default("RWF")
  status            String           @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  paymentStatus     String           @default("UNPAID") // UNPAID, DEPOSIT_PAID, FULLY_PAID, REFUNDED
  specialRequests   String?
  guestName         String
  guestEmail        String
  guestPhone        String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  payment           Payment?
  review            Review?

  @@index([customerId])
  @@index([businessId])
  @@index([serviceOfferingId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id              String    @id @default(cuid())
  bookingId       String    @unique
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactionRef  String    @unique
  providerRef     String?   // Reference returned by the upstream gateway
  provider        String    // MTN_MOMO, AIRTEL_MONEY, CARD, FLUTTERWAVE
  amount          Float
  currency        String    @default("RWF")
  status          String    @default("INITIATED") // INITIATED, PENDING, SUCCESS, FAILED
  payerPhone      String?
  channelResponse String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt @default(now())

  @@index([status])
  @@index([providerRef])
}

model Review {
  id                String    @id @default(cuid())
  bookingId         String    @unique
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId        String
  customer          User      @relation(fields: [customerId], references: [id])
  rating            Int       @default(5)
  cleanlinessRating Int       @default(5)
  serviceRating     Int       @default(5)
  hospitalityRating Int       @default(5)
  valueRating       Int       @default(5)
  title             String
  comment           String
  partnerReply      String?
  partnerRepliedAt  DateTime?
  isVerified        Boolean   @default(true)
  createdAt         DateTime  @default(now())

  @@index([businessId])
  @@index([customerId])
  @@index([createdAt])
}

model QAAudit {
  id               String    @id @default(cuid())
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  auditorName      String
  score            Int       @default(95) // 0-100
  badgeGranted     String    @default("LUXE_VERIFIED")
  notes            String
  inspectionItems  String    @default("[]") // JSON string of checked criteria
  auditDate        DateTime  @default(now())
  createdAt        DateTime  @default(now())

  @@index([businessId, auditDate])
}

model TrainingCourse {
  id             String               @id @default(cuid())
  title          String
  slug           String               @unique
  category       String               // SILVER_SERVICE, ECO_TOURISM, SOMMELIER, FRONT_DESK_EXCELLENCE, HYGIENE_COMPLIANCE
  duration       String               // e.g. "2 Weeks", "3 Days"
  price          Float                @default(250000)
  currency       String               @default("RWF")
  instructor     String
  instructorBio  String
  description    String
  modules        String               @default("[]") // JSON string array
  level          String               @default("Advanced")
  rating         Float                @default(4.9)
  enrolledCount  Int                  @default(0)
  image          String
  createdAt      DateTime             @default(now())

  enrollments    TrainingEnrollment[]
}

model TrainingEnrollment {
  id                String         @id @default(cuid())
  courseId          String
  course            TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  businessId        String
  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  participantName   String
  participantEmail  String
  status            String         @default("ENROLLED") // ENROLLED, IN_PROGRESS, COMPLETED
  completedAt       DateTime?
  certificateNumber String?
  createdAt         DateTime       @default(now())

  @@index([courseId])
  @@index([businessId])
}

model SupportTicket {
  id          String    @id @default(cuid())
  ticketRef   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  subject     String
  category    String    @default("BOOKING") // BOOKING, PAYMENT, PARTNER_ONBOARDING, QA_DISPUTE, VIP_CONCIERGE
  message     String
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  priority    String    @default("HIGH") // LOW, MEDIUM, HIGH, VIP
  responses   String    @default("[]") // JSON array of response messages
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model LoyaltyTransaction {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId   String?
  points      Int       // positive = earned, negative = redeemed
  type        String    // EARNED, REDEEMED
  description String
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model PartnerSubscription {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planTier        String    // STANDARD, CERTIFIED, ELITE
  billingCycle    String    @default("MONTHLY") // MONTHLY, ANNUAL
  price           Float
  currency        String    @default("RWF")
  status          String    @default("ACTIVE") // ACTIVE, CANCELLED
  nextBillingDate DateTime
  perks           String    @default("[]") // JSON string array
  createdAt       DateTime  @default(now())

  @@index([businessId, status])
}

model ServiceRating {
  id             String   @id @default(cuid())
  serviceId      String   // service_id
  serviceName    String
  serviceType    String   @default("OTHER") // STAYS, EXPERIENCES, DINING, OTHER
  isUnregistered Boolean  @default(false)
  rating         Int
  comment        String?
  reviewerName   String   @default("Anonymous") // reviewer_name
  ipHash         String   // ip_hash
  createdAt      DateTime @default(now()) // created_at

  @@index([serviceId])
  @@index([serviceType])
  @@index([isUnregistered])
  @@index([ipHash])
}


model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String    @default("FOOTER") // FOOTER, CHECKOUT, CAMPAIGN
  status         String    @default("SUBSCRIBED") // SUBSCRIBED, UNSUBSCRIBED
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  ipHash         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   // MTN_MOMO, FLUTTERWAVE
  externalId  String
  payload     String
  processedAt DateTime @default(now())

  @@unique([provider, externalId])
}
