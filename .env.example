# ---------------------------------------------------------------------------
# Higa Lux (LuxHub) — environment configuration
# Copy to `.env` for local development and set the same keys in your hosting
# provider's dashboard for production. `.env` is git-ignored: never commit it.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# PostgreSQL connection string. Supabase / Neon / RDS all work.
# When you connect through a pooler (PgBouncer, Supabase "Transaction" mode),
# DATABASE_URL should be the pooled URL and DIRECT_DATABASE_URL the direct one;
# Prisma migrations need the direct connection. Without a pooler, set both to
# the same value.
DATABASE_URL="postgresql://user:password@localhost:5432/higalux?schema=public"
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/higalux?schema=public"

# --- Authentication (required) ---------------------------------------------
# Signing key for session JWTs. MUST be at least 32 characters and unique per
# environment. Generate with:  openssl rand -base64 48
JWT_SECRET=""

# Salt mixed into the SHA-256 hash of visitor IPs used for public-rating
# anti-spam. Required in production; generate the same way as JWT_SECRET.
RATING_IP_SALT=""

# --- Application (required) ------------------------------------------------
# Deployment environment: development | staging | production. This — not
# NODE_ENV — decides whether demo shortcuts are permitted and whether session
# cookies are marked Secure. It defaults to "production" when unset, so a real
# deployment is safe by default; set it explicitly for local and staging use.
NEXT_PUBLIC_APP_ENV="production"

NEXT_PUBLIC_APP_URL="https://higalux.rw"

# --- Demo mode (optional, non-production only) -----------------------------
# "true" enables the seeded demo accounts, the login quick-fill buttons and the
# one-click role switcher. Forced off whenever NODE_ENV=production.
NEXT_PUBLIC_DEMO_MODE="false"

# --- Payments --------------------------------------------------------------
# Which gateway handles a given rail. Values: mtn_momo | flutterwave | manual
# "manual" records the payment as PENDING for back-office reconciliation
# instead of charging anything — safe default before gateway go-live.
PAYMENTS_MOMO_PROVIDER="manual"
PAYMENTS_CARD_PROVIDER="manual"

# MTN MoMo Collections (https://momodeveloper.mtn.com)
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"
MTN_MOMO_CALLBACK_SECRET=""

# Flutterwave (cards + Airtel Money aggregation, https://developer.flutterwave.com)
FLUTTERWAVE_BASE_URL="https://api.flutterwave.com/v3"
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# --- Media hosting ---------------------------------------------------------
# Comma-separated list of extra hostnames allowed by next/image, e.g. your S3,
# Cloudinary or Vercel Blob domain. images.unsplash.com is allowed by default
# only when NEXT_PUBLIC_DEMO_MODE is enabled.
NEXT_PUBLIC_IMAGE_HOSTS=""

# --- Marketing links (optional) --------------------------------------------
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_TWITTER=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
